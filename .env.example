# Server-side secrets for /api/social-stats. Set them in Vercel → Project → Settings →
# Environment Variables (or `vercel env add`). Never commit real values.
# Any platform whose variables are missing is simply skipped.

# YouTube Data API v3 — Google Cloud API key restricted to "YouTube Data API v3"
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCj_t2vjekkeGnAwtrinPrDg

# TikTok Display API — app from developers.tiktok.com (Login Kit + scopes user.info.basic, user.info.stats, video.list)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://<your-domain>/api/tiktok/callback

# Facebook Page — Page token with pages_read_engagement, derived from a long-lived user token (does not expire)
FACEBOOK_PAGE_ID=1419154351285103
FACEBOOK_ACCESS_TOKEN=
# FACEBOOK_GRAPH_VERSION=v27.0

# Upstash Redis (Vercel Marketplace → Redis) — stores TikTok's rotating refresh token
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Long random string; guards the one-time /api/tiktok/login?key=... link
ADMIN_SECRET=

# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" to /api/tiktok/keepalive
CRON_SECRET=
